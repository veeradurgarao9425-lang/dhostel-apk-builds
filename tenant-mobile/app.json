{
  "expo": {
    "name": "tenant-mobile",
    "slug": "tenant-mobile",
    "scheme": "hostixtenant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/HostixNew.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.durgarao2.hostixtenant",
      "adaptiveIcon": {
        "backgroundColor": "#6D4AFF",
        "foregroundImage": "./assets/HostixNew.png",
        "backgroundImage": "./assets/HostixNew.png",
        "monochromeImage": "./assets/HostixNew.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/HostixNew.png"
    },
    "splash": {
      "image": "./assets/HostixNew.png",
      "resizeMode": "contain",
      "backgroundColor": "#6D4AFF"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/HostixNew.png",
          "color": "#6D4AFF"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Hostix to save receipts to your device.",
          "savePhotosPermission": "Allow Hostix to save receipts to your Downloads.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "owner": "durgarao2",
    "extra": {
      "eas": {
        "projectId": "638341a5-845d-4e85-8a75-94ebf64204fa"
      }
    }
  }
}
