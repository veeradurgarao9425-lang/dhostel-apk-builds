{
  "expo": {
    "name": "Hostix",
    "slug": "stivo-mobile",
    "scheme": "hostix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/HostixNew.png",
    "userInterfaceStyle": "automatic",

    "splash": {
      "image": "./assets/HostixNew.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#6D4AFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/HostixNew.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.durgarao2.hostixmobile",
      "usesCleartextTraffic": true,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "RECEIVE_BOOT_COMPLETED",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/HostixNew.png"
    },
    "plugins": [
      "./plugins/withCleartextTraffic.js",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6D4AFF"
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "7303856b-fde0-4922-baf9-c6487aa06e02"
      }
    }
  }
}
