{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    // src/**/__tests__ run on Node's own test runner (`npm test`), whose ESM
    // resolver requires the file extension on relative imports. Safe with
    // noEmit — app code keeps using extensionless imports via Metro.
    "allowImportingTsExtensions": true,
    "strict": true,
    "jsx": "react-native",
    "lib": [
      "dom",
      "esnext"
    ],
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "target": "esnext"
  },
  "include": [
    "src/**/*",
    "App.tsx",
    "index.ts",
    "i18n.ts"
  ],
  "exclude": [
    "node_modules",
    ".expo",
    "android",
    "ios",
    "dist",
    "scratch"
  ]
}